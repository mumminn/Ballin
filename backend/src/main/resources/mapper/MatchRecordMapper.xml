<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.domain.matchRecord.mapper.MatchRecordMapper">

    <resultMap id="MatchRecordResult" type="com.example.backend.domain.matchRecord.entity.MatchRecordEntity">
        <id column="id" property="recordId" javaType="java.util.UUID" typeHandler="com.example.backend.global.mybatis.UUIDTypeHandler"/>
        <result column="user_id" property="userId" javaType="java.util.UUID" typeHandler="com.example.backend.global.mybatis.UUIDTypeHandler"/>
        <result column="supporting_team_id" property="supportingTeamId" javaType="java.util.UUID" typeHandler="com.example.backend.global.mybatis.UUIDTypeHandler"/>
        <result column="opposing_team_id" property="opposingTeamId" javaType="java.util.UUID" typeHandler="com.example.backend.global.mybatis.UUIDTypeHandler"/>
        <result column="stadium_id" property="stadiumId" javaType="java.util.UUID" typeHandler="com.example.backend.global.mybatis.UUIDTypeHandler"/>
        <result column="category_id" property="categoryId" javaType="java.util.UUID" typeHandler="com.example.backend.global.mybatis.UUIDTypeHandler"/>
        <result column="match_date" property="matchDate" javaType="java.time.Instant"/>
        <result column="winning_score" property="winningScore"/>
        <result column="losing_score" property="losingScore"/>
        <result column="team_result" property="teamResult" javaType="com.example.backend.domain.matchRecord.entity.TeamResult"/>
        <result column="review" property="review" />
        <result column="match_image" property="match" javaType="[B" jdbcType="BLOB"/>
        <result column="seat" property="seat"/>
        <result column="created_dt"  property="createdDt"   javaType="java.time.Instant"/>
        <result column="updated_dt"  property="updatedDt"   javaType="java.time.Instant"/>
        <result column="created_id"  property="createdId"   javaType="java.util.UUID" typeHandler="com.example.backend.global.mybatis.UUIDTypeHandler"/>
        <result column="updated_id"  property="updatedId"   javaType="java.util.UUID" typeHandler="com.example.backend.global.mybatis.UUIDTypeHandler"/>
    </resultMap>

    <select id="findByCategoryId" resultType="com.example.backend.domain.matchRecord.entity.MatchRecordEntity">
        SELECT *
        FROM match_record
        WHERE category_id = #{categoryId, jdbcType=BINARY, typeHandler=com.example.backend.global.mybatis.UUIDTypeHandler}
    </select>


    <select id="findAll" resultType="com.example.backend.domain.matchRecord.entity.MatchRecordEntity">
        SELECT *
        FROM match_record
        WHERE category_id = #{categoryId, jdbcType=BINARY, typeHandler=com.example.backend.global.mybatis.UUIDTypeHandler}
    </select>
</mapper>