<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.domain.stadium.mapper.StadiumMapper">
    <resultMap id="StadiumResult" type="com.example.backend.domain.stadium.entity.StadiumEntity">
        <id column="id" property="stadiumId" javaType="java.util.UUID"/>
        <result column="team_id"  property="teamId"/>
        <result column="category_id"  property="categoryId"/>
        <result column="stadium_name" property="stadiumName"/>
        <result column="location" property="location"/>
        <result column="created_dt"  property="createdDt"   javaType="java.time.Instant"/>
        <result column="updated_dt"  property="updatedDt"   javaType="java.time.Instant"/>
        <result column="created_id"  property="createdId"/>
        <result column="updated_id"  property="updatedId"/>
    </resultMap>

    <select id="findIdByTeamId" parameterType="map" resultType="java.util.UUID">
        SELECT s.id
        FROM stadium s
        WHERE s.team_id = #{teamId}
    </select>

    <select id="findVisitedStadium" resultType="string">
        SELECT DISTINCT t.team_code
        FROM match_record mr
        JOIN stadium s ON mr.stadium_id = s.id
        JOIN category c ON mr.category_id = c.id
        JOIN team t
        WHERE mr.user_id = #{userId}
        AND c.category_name = #{category}
        AND s.team_id = t.id
    </select>

</mapper>