<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.domain.user.mapper.UserMapper">

    <resultMap id="UserResult" type="com.example.backend.domain.user.entity.UserEntity">
        <id     column="id"          property="id"          javaType="java.util.UUID"/>
        <result column="email"       property="email"/>
        <result column="password"    property="password"/>
        <result column="name"        property="name"/>
        <result column="social_type" property="socialType"  javaType="com.example.backend.domain.user.entity.SocialType"/>
        <result column="created_dt"  property="createdDt"   javaType="java.time.Instant"/>
        <result column="updated_dt"  property="updatedDt"   javaType="java.time.Instant"/>
        <result column="created_id"  property="createdId"   javaType="java.util.UUID"/>
        <result column="updated_id"  property="updatedId"   javaType="java.util.UUID"/>
    </resultMap>

    <select id="findByEmail" parameterType="string" resultMap="UserResult">
        SELECT id, email, password, "name", social_type,
        created_dt, updated_dt, created_id, updated_id
        FROM "user"
        WHERE email = #{email}
        LIMIT 1
    </select>

    <select id="findById" parameterType="string" resultMap="UserResult">
        SELECT id, email, password, "name", social_type,
        created_dt, updated_dt, created_id, updated_id
        FROM "user"
        WHERE id = #{id}
        LIMIT 1
    </select>

    <insert id="insertUser" parameterType="com.example.backend.domain.user.entity.UserEntity">
        INSERT INTO "user" (id, email, password, "name", social_type, created_dt, updated_dt, created_id, updated_id)
        VALUES (
        #{id},
        #{email}, #{password}, #{name},
        #{socialType},
        #{createdDt, jdbcType=TIMESTAMP},
        #{updatedDt, jdbcType=TIMESTAMP},
        #{createdId},
        #{updatedId}
        )
    </insert>

    <update id="updateUserBasic" parameterType="com.example.backend.domain.user.entity.UserEntity">
        UPDATE "user"
        SET "name" = #{name},
        updated_id = #{updatedId},
        updated_dt = #{updatedDt, jdbcType=TIMESTAMP}
        WHERE id = #{id}
    </update>

    <update id="updateUser" parameterType="com.example.backend.domain.user.entity.UserEntity">
        UPDATE "user"
        <set>
            <if test="email != null"> email = #{email}, </if>
            <if test="name != null"> name = #{name}, </if>
        </set>
        WHERE id = #{id}
    </update>
    
    <select id="existsByEmailExcludingId" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM "user"
            WHERE LOWER(email) = LOWER(#{email})
            AND id != #{id}
        )
    </select>

    <update id="updatePassword">
        UPDATE "user"
        SET password = #{password}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="java.util.UUID">
        DELETE FROM "user"
        WHERE id = #{id}
    </delete>

</mapper>